# Crew – Konfiguration. Kopieren nach .env und anpassen. .env NIE committen.

# Öffentliche Domain (DNS muss auf den Server zeigen). Lokal: localhost
DOMAIN=crew.example.com

# Kontakt-E-Mail für Let's Encrypt
ACME_EMAIL=admin@example.com

# Erster Superuser (Dashboard /_/). Wird bei jedem Start per
# "pocketbase superuser upsert" angelegt bzw. aktualisiert.
# Nach dem ersten Start dürfen die Werte wieder geleert werden.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=bitte-ein-langes-zufaelliges-passwort

# Verschlüsselt Einstellungen (SMTP/S3-Zugänge) in pb_data. Genau 32 Zeichen,
# z. B.: openssl rand -hex 16   – NICHT mehr ändern, sobald gesetzt.
PB_ENCRYPTION_KEY=

# Wer das Dashboard /_/ über die Domain erreichen darf (Caddy remote_ip).
# Leerzeichen-getrennt, z. B. "private_ranges 203.0.113.10/32"
ADMIN_ALLOWED_IPS=private_ranges

# --- Nur für Cloudflare Tunnel (sonst leer lassen) ----------------------
# Caddy antwortet dann per HTTP an cloudflared (Cloudflare macht HTTPS)
# und zusätzlich per HTTPS unter der Tailscale-/LAN-IP fürs Dashboard.
# SITE_ADDRESSES=http://chat.example.com, 100.99.251.25
# DEFAULT_SNI=100.99.251.25

# Lokaler Port für den direkten Zugriff auf PocketBase (nur 127.0.0.1)
PB_LOCAL_PORT=8090

