# Crew – Reverse Proxy mit automatischem HTTPS und Security-Headern.
#
# DOMAIN            z. B. crew.example.com (für lokale Tests: localhost)
# ACME_EMAIL        Kontakt für Let's Encrypt
# ADMIN_ALLOWED_IPS IPs/Netze, die das Dashboard /_/ erreichen dürfen
#                   (Standard: private_ranges = nur LAN/VPN)
# SITE_ADDRESSES    Adressen, unter denen Caddy antwortet (Standard: DOMAIN).
#                   Cloudflare Tunnel: "http://chat.example.de, 100.x.y.z"
# DEFAULT_SNI       Zertifikat für Aufrufe per IP (Standard: DOMAIN)
{
	email {$ACME_EMAIL}
	# Browser senden bei IP-Adressen keinen Servernamen (SNI) mit.
	# Ohne diese Zeile findet Caddy dann kein Zertifikat (z. B. Safari:
	# "keine sichere Verbindung"). Für echte Domains ohne Wirkung.
	default_sni {$DEFAULT_SNI}

	servers {
		# Echte Besucher-IP hinter Cloudflare Tunnel: cloudflared läuft auf dem
		# Host und erreicht Caddy über Loopback bzw. das Docker-Netz. Nur von
		# dort wird Cf-Connecting-IP geglaubt – nicht von LAN- oder Internet-Clients.
		trusted_proxies static 127.0.0.0/8 ::1 172.16.0.0/12
		client_ip_headers Cf-Connecting-IP
	}
}

{$SITE_ADDRESSES} {
	encode zstd gzip

	# --- Dashboard nur aus erlaubten Netzen ------------------------------
	@dashboard path /_ /_/*
	@dashboardBlocked {
		path /_ /_/*
		not client_ip {$ADMIN_ALLOWED_IPS:private_ranges}
	}
	respond @dashboardBlocked "Not found" 404

	# --- Security-Header für alle Antworten -------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
		-X-Powered-By
		defer
	}

	# --- Strikte CSP für die App (kein unsafe-inline, kein unsafe-eval) ---
	@app not path /_ /_/*
	header @app {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		defer
	}

	# Das PocketBase-Dashboard bringt eigene Inline-Styles mit; hier nur Framing verbieten.
	header @dashboard {
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		defer
	}

	# App-Dateien immer beim Server nachfragen (304, wenn unverändert),
	# damit Updates sofort ankommen. Die API wird ohnehin nicht gecacht.
	@static not path /api/* /_ /_/* /fonts/*
	header @static Cache-Control "no-cache"
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=604800"

	reverse_proxy pocketbase:8090 {
		# Realtime (SSE) sofort durchreichen.
		flush_interval -1
		# PocketBase bekommt genau eine, von Caddy ermittelte Client-IP
		# (Grundlage für Rate-Limits).
		header_up X-Forwarded-For {client_ip}
	}
}
